# Copy to .env for local development. NEVER commit the real .env.

# Google Safe Browsing v4 API key (free):
# https://console.cloud.google.com -> enable "Safe Browsing API" -> create API key
# Leave empty to run heuristics-only (the check reports as 'unavailable').
GOOGLE_SAFE_BROWSING_API_KEY=

# Origins allowed to call this API (comma-separated).
# Production should be exactly the GitHub Pages origin:
# ALLOWED_ORIGINS=https://kadeemj.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null

# Requests per minute per client IP before 429s
RATE_LIMIT_PER_MINUTE=10
